# macOS
.DS_Store
._*

# 로컬 도구 설정 (개인 환경, 공유 대상 아님)
.claude/
.mcp.json
.vscode/
.idea/

# 작업 부산물 — 절대 커밋하지 말 것
_snapshots/
assets/_legacy/
legacy/
*.blend
*.blend1

# 실제 급식실 CCTV 프레임. 조리원이 찍혀 있어 공개 저장소에 올리지 않는다.
# 참조 오버레이(sim.html?ref=…)는 이 폴더가 없으면 조용히 꺼진다.
refs/

# 원본 상용/외부 에셋 (라이선스상 재배포 불가)
assets/sketchfab_*.glb
assets/cook_cc_*.glb

# 시뮬레이터가 생성한 데이터셋 / 실행 기록
dataset/*
!dataset/trajectories/
dataset/trajectories/*
# LSTM 학습 궤적 데이터 — 전체(120개·4.3MB)는 무시하되,
# 형태를 볼 수 있게 대표 예시 3개만 추적한다(크기가 다른 = 활동량이 다른 장면).
!dataset/trajectories/README.md
!dataset/trajectories/island_h58_seed10_0009.json
!dataset/trajectories/island_h58_seed11_0010.json
!dataset/trajectories/real_test_sample.json
# P0-1 split manifest — 데이터 파일은 무시해도 split(seed 단위 train/val/test)은
# 반드시 추적한다(재현·감사 근거). 전체 데이터가 없어도 이 파일이 canonical split.
!dataset/trajectories/split_manifest.json
sim-person/
runs/
captures/
*.zip

# YOLO 학습 산출물 (용량 큼 — 가중치·플롯·로그)
training/
yolo*.pt
*.log

# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# 시크릿 — 절대 커밋 금지 (.env.example만 커밋)
.env
.env.local
.env.*.local
.vercel
